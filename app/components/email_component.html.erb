<table width="100%" cellpadding="0" cellspacing="0" style="font-family: Marianne, arial, sans-serif; background-color: #ffffff;">
  <tr>
    <td align="center" style="padding: 24px 16px;">
      <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff;">

        <%# Header %>
        <tr>
          <td align="center" style="background-color: #ececfe; padding: 54px 32px;">
            <img src="<%= image_data_uri('passe-marche-logo-email.png') %>"
                 alt="<%= t('mailer.shared_header.logo_alt') %>"
                 width="261"
                 height="43"
                 style="display: block; width: 261px; height: 43px; margin: 0 auto;" />
          </td>
        </tr>

        <%# Body %>
        <tr>
          <td style="padding: 48px 39px 40px;">
            <h1 style="margin: 0 0 16px; font-size: 24px; font-weight: 700; color: #161616; line-height: 1.3;">
              <%= @title %>
            </h1>

            <% if @greeting.present? %>
              <p style="margin: 0 0 16px; font-size: 14px; font-weight: 700; color: #161616; line-height: 1.5;">
                <%= @greeting %>
              </p>
            <% end %>

            <p style="margin: 0; font-size: 14px; color: #3a3a3a; line-height: 1.5;">
              <%= @intro %>
            </p>

            <% if @url.present? %>
              <% if @cta_intro.present? %>
                <p style="margin: 24px 0 0; font-size: 14px; color: #3a3a3a; line-height: 1.5;">
                  <%= @cta_intro %>
                </p>
              <% end %>

              <table cellpadding="0" cellspacing="0" align="center" style="margin: 40px auto 0;">
                <tr>
                  <td style="background-color: #000091;">
                    <%= link_to @cta_label, @url,
                      style: "display: inline-block; padding: 10px 24px; color: #f5f5fe; font-size: 18px; font-weight: 500; line-height: 28px; text-decoration: none; white-space: nowrap;" %>
                  </td>
                </tr>
              </table>
            <% end %>

            <% if @notice.present? %>
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-top: 40px; background-color: #f5f5fe;">
                <tr>
                  <td width="24" valign="top" style="padding: 12px 17px 12px 13px;">
                    <img src="<%= image_data_uri('icon-email-warning.png') %>"
                         alt=""
                         width="24"
                         height="24"
                         style="display: block; width: 24px; height: 24px;" />
                  </td>
                  <td style="padding: 12px 13px 12px 0; font-size: 14px; color: #000000; line-height: 24px;">
                    <%= @notice %>
                  </td>
                </tr>
              </table>
            <% end %>

            <% if @warning.present? %>
              <p style="margin: 24px 0 0; font-size: 11px; color: #b34000; font-weight: 500; line-height: 1.5;">
                <%= @warning %>
              </p>
            <% end %>
          </td>
        </tr>

        <%# Footer %>
        <tr>
          <td style="padding: 28px 32px; text-align: center; background-color: #f6f6f6;">
            <p style="margin: 0 0 12px; font-size: 12px;">
              <a href="#" style="color: #000091; text-decoration: none;"><%= t('mailer.shared_footer.privacy') %></a><span style="color: #000091;">|</span><a href="#" style="color: #000091; text-decoration: none;"><%= t('mailer.shared_footer.legal') %></a>
            </p>
            <p style="margin: 0 0 8px; font-size: 12px; color: #666666;"><%= t('mailer.shared_footer.copyright') %></p>
            <p style="margin: 0; font-size: 11px; color: #666666;"><%= t('mailer.shared_footer.contact') %></p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
