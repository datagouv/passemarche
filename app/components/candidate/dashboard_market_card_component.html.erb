<div class="fr-card fr-card--no-arrow fr-mb-2w">
  <div class="fr-card__body">
    <div class="fr-card__content">
      <h2 class="fr-h4 fr-mb-1w"><%= market.name %></h2>

      <p class="fr-text--sm fr-text-mention--grey fr-mb-0">
        <span class="fr-icon-building-line fr-icon--sm" aria-hidden="true"></span>
        <%= market.buyer_display_name %>
      </p>

      <% market.applications.each do |application| %>
        <%= render Candidate::DashboardApplicationRowComponent.new(application:) %>
      <% end %>
    </div>
  </div>
</div>
