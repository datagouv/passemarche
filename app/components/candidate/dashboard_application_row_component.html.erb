<div class="dashboard-application-row fr-py-3w">
  <div class="dashboard-application-row__content">
    <div class="dashboard-application-row__heading fr-mb-1w">
      <span class="<%= application.kind_icon_class %> fr-icon--sm fr-text-action-high--blue-france" aria-hidden="true"></span>
      <h3 class="fr-text--md fr-text--bold fr-mb-0"><%= application.kind_label %></h3>
      <p class="fr-badge fr-badge--sm <%= application.status_badge_class %>"><%= application.status_label %></p>
    </div>

    <% if mandataire_label %>
      <p class="fr-text--sm fr-mb-1w"><%= mandataire_label %></p>
    <% end %>

    <p class="fr-text--sm fr-mb-0">
      <% if application.lots.any? %>
        <%= t("candidate.dashboard.application.lots_count", count: application.lots.size) %>
        &nbsp;
      <% end %>

      <span class="fr-text-mention--grey">
        <span class="<%= application.dated_on_icon_class %> fr-icon--sm" aria-hidden="true"></span>
        <%= application.dated_on_label %>
      </span>
    </p>
  </div>

  <% if actions.any? %>
    <ul class="fr-btns-group fr-btns-group--sm fr-btns-group--inline fr-btns-group--right">
      <% if actions.include?(:view) %>
        <li>
          <%= link_to consultation_candidate_market_application_path(application.identifier),
                      class: "fr-btn fr-btn--sm fr-btn--secondary" do %>
            <%= t("candidate.dashboard.actions.view") %>
          <% end %>
        </li>
      <% end %>
      <% if actions.include?(:follow_up) %>
        <li>
          <%= link_to grouping_dashboard_candidate_market_application_path(application.identifier),
                class: "fr-btn fr-btn--sm fr-btn--icon-left" do %>
            <span class="fr-icon-eye-line fr-icon--sm" aria-hidden="true"></span>
            <%= t("candidate.dashboard.actions.follow_up") %>
          <% end %>
        </li>
      <% end %>
      <% if actions.include?(:delete) %>
        <li>
          <button class="fr-btn fr-btn--sm fr-btn--secondary fr-btn--tertiary fr-btn--icon-left"
                  data-fr-opened="false"
                  aria-controls="deletion-modal-<%= application.identifier %>">
            <span class="fr-icon-delete-bin-line fr-icon--sm" aria-hidden="true"></span>
            <%= t("candidate.dashboard.actions.delete") %>
          </button>
        </li>
      <% end %>
      <% if actions.include?(:edit) %>
        <li>
          <%= link_to company_identification_candidate_market_application_path(application.identifier),
                class: "fr-btn fr-btn--sm fr-btn--icon-left" do %>
            <span class="fr-icon-edit-line fr-icon--sm" aria-hidden="true"></span>
            <%= t("candidate.dashboard.actions.edit") %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<%= helpers.render "candidate/dashboards/delete_modal", application: application if actions.include?(:delete) %>
