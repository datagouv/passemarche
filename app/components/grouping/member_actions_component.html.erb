<div id="grouping_member_actions_<%= member.id %>" class="grouping-member-actions">
  <% actions.each do |action| %>
    <% case action %>
    <% when :edit %>
      <%= link_to t('candidate.grouping_dashboard.action_edit'),
            step_candidate_market_application_path(member_application_identifier, :summary),
            class: 'fr-btn fr-btn--sm fr-btn--secondary fr-icon-edit-line fr-btn--icon-left' %>
    <% when :consult %>
      <%= link_to t('candidate.grouping_dashboard.action_consult'),
            consultation_candidate_market_application_path(member_application_identifier),
            class: 'fr-btn fr-btn--sm fr-btn--secondary' %>
    <% when :prepare %>
      <%= link_to t('candidate.grouping_dashboard.action_prepare'),
            company_identification_candidate_market_application_path(member_application_identifier),
            class: 'fr-btn fr-btn--sm fr-icon-arrow-right-line fr-btn--icon-right' %>
    <% when :copy_link %>
      <% if invitation_sent? %>
        <div data-controller="clipboard" class="fr-inline-block">
          <span class="fr-hidden" data-clipboard-target="text"><%= invitation_url %></span>
          <button type="button" data-clipboard-target="button" data-action="click->clipboard#copy"
                  class="fr-btn fr-btn--sm fr-btn--secondary fr-icon-clipboard-line fr-btn--icon-left">
            <%= t('candidate.grouping_dashboard.action_copy_link') %>
          </button>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
