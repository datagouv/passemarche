<%= render Shared::ConfirmationLayoutComponent.new do |layout| %>
  <% layout.with_illustration do %>
    <%= image_tag 'sync_status_error.png', alt: '' %>
  <% end %>

  <h1 class="fr-h3"><%= heading %></h1>
  <% paragraphs.each do |paragraph| %>
    <p><%= paragraph %></p>
  <% end %>

  <% if action? %>
    <div class="fr-btns-group fr-mt-3w">
      <%= action %>
    </div>
  <% end %>
<% end %>
