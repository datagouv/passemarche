<div class="nested-form-wrapper fr-card fr-card--sm fr-mb-2w" data-new-record="<%= index == 'NEW_RECORD' %>">
  <div class="fr-card__body">
    <div class="fr-card__content">
      <div class="fr-grid-row fr-grid-row--gutters fr-mb-2w">
        <div class="fr-col-12">
          <h6 class="fr-text--sm fr-mb-2w">
            <% if display_number %>
              <%= t('candidate.market_applications.form_fields.realisations_livraisons.item_title', number: display_number) %>
            <% else %>
              <%= t('candidate.market_applications.form_fields.realisations_livraisons.new_item_title') %>
            <% end %>
          </h6>
        </div>
      </div>

      <div class="fr-grid-row fr-grid-row--gutters">
        <div class="fr-col-12">
          <div class="fr-input-group">
            <%= response_form.label "realisation_#{index}_resume", t('candidate.market_applications.form_fields.realisations_livraisons.labels.resume'), class: "fr-label" %>
            <span class="fr-hint-text"><%= t('candidate.market_applications.form_fields.realisations_livraisons.hints.resume') %></span>
            <%= response_form.text_field "realisation_#{index}_resume",
              value: index == 'NEW_RECORD' ? '' : component.get_item_field(index, 'resume'),
              class: "fr-input",
              placeholder: t('candidate.market_applications.form_fields.realisations_livraisons.placeholders.resume') %>
          </div>
        </div>
      </div>

      <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
        <div class="fr-col-6">
          <div class="fr-input-group">
            <%= response_form.label "realisation_#{index}_date_debut", t('candidate.market_applications.form_fields.realisations_livraisons.labels.date_debut'), class: "fr-label" %>
            <%= response_form.text_field "realisation_#{index}_date_debut",
                  type: "date",
                  value: index == 'NEW_RECORD' ? '' : component.get_item_field(index, 'date_debut'),
                  class: "fr-input" %>
          </div>
        </div>
        <div class="fr-col-6">
          <div class="fr-input-group">
            <%= response_form.label "realisation_#{index}_date_fin", t('candidate.market_applications.form_fields.realisations_livraisons.labels.date_fin'), class: "fr-label" %>
            <%= response_form.text_field "realisation_#{index}_date_fin",
                  type: "date",
                  value: index == 'NEW_RECORD' ? '' : component.get_item_field(index, 'date_fin'),
                  class: "fr-input" %>
          </div>
        </div>
      </div>

      <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
        <div class="fr-col-6">
          <div class="fr-input-group">
            <%= response_form.label "realisation_#{index}_montant", t('candidate.market_applications.form_fields.realisations_livraisons.labels.montant'), class: "fr-label" %>
            <%= response_form.text_field "realisation_#{index}_montant",
              type: "number",
              value: index == 'NEW_RECORD' ? '' : component.get_item_field(index, 'montant'),
              class: "fr-input",
              placeholder: t('candidate.market_applications.form_fields.realisations_livraisons.placeholders.montant'),
              min: 1,
              step: 1 %>
          </div>
        </div>
      </div>

      <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
        <div class="fr-col-12">
          <div class="fr-input-group">
            <%= response_form.label "realisation_#{index}_description", t('candidate.market_applications.form_fields.realisations_livraisons.labels.description'), class: "fr-label" %>
            <span class="fr-hint-text"><%= t('candidate.market_applications.form_fields.realisations_livraisons.hints.description') %></span>
            <%= response_form.text_area "realisation_#{index}_description",
              value: index == 'NEW_RECORD' ? '' : component.get_item_field(index, 'description'),
              class: "fr-input",
              placeholder: t('candidate.market_applications.form_fields.realisations_livraisons.placeholders.description'),
              rows: 4 %>
          </div>
        </div>
      </div>

      <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
        <div class="fr-col-8">
          <% attestations = index == 'NEW_RECORD' ? nil : component.realisation_attestations(index) %>
          <%= direct_upload_field documents: attestations,
                                  market_application_identifier: component.market_attribute_response.market_application.identifier,
                                  deletable: true,
                                  form: response_form,
                                  field_name: "realisation_#{index}_attestation_bonne_execution" do %>
            <%= response_form.label "realisation_#{index}_attestation_bonne_execution", t('candidate.market_applications.form_fields.realisations_livraisons.labels.attestation_bonne_execution'), class: "fr-label" %>
            <span class="fr-hint-text"><%= t('candidate.market_applications.form_fields.realisations_livraisons.hints.attestation_bonne_execution') %></span>
            <%= response_form.file_field "realisation_#{index}_attestation_bonne_execution",
                  class: "fr-upload",
                  direct_upload: true,
                  accept: ".pdf,.doc,.docx",
                  multiple: true %>
          <% end %>
        </div>
        <div class="fr-col-4">
          <%= response_form.hidden_field "realisation_#{index}__destroy", value: '0' %>
          <div class="fr-mt-4w">
            <%= nested_form_delete_button(t('candidate.market_applications.form_fields.realisations_livraisons.delete_button')) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
