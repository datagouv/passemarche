<div id="grouping_member_removal_errors">
  <% if errors.present? %>
    <div class="fr-alert fr-alert--error fr-mb-3w" role="alert">
      <p class="fr-alert__title"><%= t('candidate.grouping_compositions.removal_error_title') %></p>
      <ul>
        <% errors.each do |_attribute, messages| %>
          <% Array(messages).each do |message| %>
            <li><%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
