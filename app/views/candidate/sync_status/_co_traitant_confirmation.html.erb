<%= render Shared::ConfirmationLayoutComponent.new do |layout| %>
  <% layout.with_illustration do %>
    <%= image_tag "sync_status_success.png", alt: "" %>
  <% end %>

  <div class="fr-mb-4w">
    <h1 class="fr-h1"><%= t('candidate.sync_status.co_traitant_title') %></h1>
    <p class="fr-text--lg"><%= t('candidate.sync_status.co_traitant_message') %></p>
    <%= link_to t('candidate.sync_status.back_to_grouping_dashboard'),
                grouping_dashboard_candidate_market_application_path(@market_application.identifier),
                class: 'fr-btn fr-btn--secondary' %>
  </div>
<% end %>
