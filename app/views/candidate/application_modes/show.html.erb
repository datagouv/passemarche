<% content_for :title, t('candidate.application_modes.title') %>

<div class="fr-container fr-py-6w">
  <h1 class="fr-h3 fr-mb-4w"><%= t('candidate.application_modes.title') %></h1>

  <% if @errors.present? %>
    <div class="fr-alert fr-alert--error fr-mb-3w" role="alert">
      <p class="fr-alert__title"><%= t('candidate.application_modes.title') %></p>
      <ul>
        <% @errors.each do |_attribute, messages| %>
          <% Array(messages).each do |message| %>
            <li><%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @already_mandataire %>
    <div class="fr-callout application-mode-callout fr-mb-4w">
      <h3 class="fr-callout__title"><%= t('candidate.application_modes.already_mandataire_box.title') %></h3>
      <p class="fr-callout__text"><%= t('candidate.application_modes.already_mandataire_box.body') %></p>
    </div>
  <% else %>
    <div class="fr-callout application-mode-callout fr-mb-4w">
      <h3 class="fr-callout__title"><%= t('candidate.application_modes.info_box.title') %></h3>
      <p class="fr-callout__text"><%= t('candidate.application_modes.info_box.body') %></p>
    </div>
  <% end %>

  <%= form_with url: application_mode_candidate_market_application_path(@market_application.identifier),
                method: :patch,
                data: { controller: "enable-on-choice" } do |form| %>
    <fieldset class="fr-fieldset" <%= "disabled" if @readonly %>>
      <legend class="fr-fieldset__legend fr-sr-only"><%= t('candidate.application_modes.title') %></legend>

      <div class="fr-fieldset__content application-mode-choices">
        <div class="application-mode-choice">
          <input type="radio"
                 id="application_mode_solo"
                 name="application_mode"
                 value="solo"
                 class="application-mode-choice__input"
                 <%= "checked" if @market_application.solo? %>
                 <%= "disabled" if @readonly %>
                 data-enable-on-choice-target="choice"
                 data-action="change->enable-on-choice#toggle">
          <label class="application-mode-choice__label" for="application_mode_solo">
            <span class="application-mode-choice__text">
              <span class="application-mode-choice__text-content">
                <span class="application-mode-choice__title"><%= t('candidate.application_modes.solo.label') %></span>
                <span class="application-mode-choice__hint"><%= t('candidate.application_modes.solo.hint') %></span>
              </span>
            </span>
            <span class="application-mode-choice__icon">
              <%= image_tag "icon-candidacy-solo.svg", alt: "", class: "application-mode-choice__icon-img" %>
            </span>
          </label>
        </div>

        <div class="application-mode-choice">
          <input type="radio"
                 id="application_mode_groupement"
                 name="application_mode"
                 value="groupement"
                 class="application-mode-choice__input"
                 <%= "checked" if @market_application.groupement? %>
                 <%= "disabled" if @already_mandataire || @readonly %>
                 data-enable-on-choice-target="choice"
                 data-action="change->enable-on-choice#toggle">
          <label class="application-mode-choice__label" for="application_mode_groupement">
            <span class="application-mode-choice__text">
              <span class="application-mode-choice__text-content">
                <span class="application-mode-choice__title"><%= t('candidate.application_modes.groupement.label') %></span>
                <span class="application-mode-choice__hint"><%= t('candidate.application_modes.groupement.hint') %></span>
              </span>
            </span>
            <span class="application-mode-choice__icon">
              <%= image_tag "icon-candidacy-groupement.svg", alt: "", class: "application-mode-choice__icon-img" %>
            </span>
          </label>
        </div>

        <div class="application-mode-choice">
          <input type="radio"
                 id="application_mode_mixte"
                 name="application_mode"
                 value="mixte"
                 class="application-mode-choice__input"
                 <%= "disabled" if @already_mandataire || @readonly %>
                 data-enable-on-choice-target="choice"
                 data-action="change->enable-on-choice#toggle">
          <label class="application-mode-choice__label" for="application_mode_mixte">
            <span class="application-mode-choice__text">
              <span class="application-mode-choice__text-content">
                <span class="application-mode-choice__title"><%= t('candidate.application_modes.mixte.label') %></span>
                <span class="application-mode-choice__hint"><%= t('candidate.application_modes.mixte.hint') %></span>
              </span>
            </span>
            <span class="application-mode-choice__icon">
              <%= image_tag "icon-candidacy-mixte.svg", alt: "", class: "application-mode-choice__icon-img" %>
            </span>
          </label>
        </div>
      </div>
    </fieldset>

    <div class="fr-mt-4w" style="text-align: right;">
      <% if @readonly %>
        <%= link_to t('candidate.application_modes.continue_readonly'),
                    grouping_legal_type_candidate_market_application_path(@market_application.identifier),
                    class: "fr-btn fr-icon-arrow-right-line fr-btn--icon-right" %>
      <% else %>
        <%= form.button t('candidate.application_modes.continue'),
                        type: "submit",
                        class: "fr-btn fr-icon-arrow-right-line fr-btn--icon-right",
                        disabled: true,
                        data: { "enable-on-choice-target": "submitButton" } %>
      <% end %>
    </div>
  <% end %>
</div>
