<section class="fr-mb-2w">
  <% if presenter.submitted? %>
    <%= render StatusNoticeComponent.new(title: t('candidate.grouping_dashboard.submission_done_title'), color: :success) do %>
      <%= t('candidate.grouping_dashboard.submission_done_body') %>
    <% end %>
  <% elsif presenter.submittable? %>
    <%= render StatusNoticeComponent.new(title: t('candidate.grouping_dashboard.submission_ready_title'), color: :success) do %>
      <%= t('candidate.grouping_dashboard.submission_ready_body') %>
    <% end %>
    <%= button_to t('candidate.grouping_dashboard.submit_full'),
          grouping_submission_candidate_market_application_path(presenter.identifier),
          params: { submission_mode: 'full' },
          class: "fr-btn fr-icon-send-plane-line fr-btn--icon-right" %>
  <% else %>
    <%= render StatusNoticeComponent.new(title: t('candidate.grouping_dashboard.submission_pending_title'), color: :warning) do %>
      <%= t('candidate.grouping_dashboard.submission_pending_body') %>
    <% end %>
    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
      <button type="button" class="fr-btn fr-icon-send-plane-line fr-btn--icon-right" disabled>
        <%= t('candidate.grouping_dashboard.submit_full') %>
      </button>

      <% if presenter.partially_submittable? %>
        <button type="button"
                class="fr-btn fr-btn--secondary"
                data-fr-opened="false"
                aria-controls="partial-submission-modal">
          <%= t('candidate.grouping_dashboard.submit_partial') %>
        </button>
        <%= render 'partial_submission_modal', identifier: presenter.identifier %>
      <% end %>
    </div>
  <% end %>
</section>
