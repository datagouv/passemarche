<% lots = market_application.lots.ordered %>

<div class="fr-mb-3w fr-pt-3w">
  <%= render 'section_title_with_edit',
        title: t('candidate.grouping_dashboard.lots_section_title'),
        edit_path: lot_selection_candidate_market_application_path(market_application.identifier),
        edit_title: t('candidate.grouping_dashboard.edit_lots') %>

  <section class="fr-accordion">
    <h3 class="fr-accordion__title">
      <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="grouping-dashboard-lots">
        <%= t('candidate.grouping_dashboard.lots_toggle_label') %>
      </button>
    </h3>
    <div class="fr-collapse" id="grouping-dashboard-lots">
      <div class="fr-accordion__body">
        <div class="fr-accordion__inner">
          <% if lots.any? %>
            <ul class="fr-tags-group fr-mb-0">
              <% lots.each do |lot| %>
                <li><span class="fr-tag"><%= lot.name.presence || t('candidate.grouping_dashboard.lot_number', number: lot.position) %></span></li>
              <% end %>
            </ul>
          <% else %>
            <p class="fr-text--sm fr-text--mention-grey fr-mb-0"><%= t('candidate.grouping_dashboard.no_lot_selected') %></p>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</div>
