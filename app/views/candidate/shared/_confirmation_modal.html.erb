<dialog aria-labelledby="<%= id %>-title"
        id="<%= id %>"
        class="fr-modal"
        role="dialog">
  <div class="fr-container fr-container--fluid fr-container-md">
    <div class="fr-grid-row fr-grid-row--center">
      <div class="fr-col-12 fr-col-md-10 fr-col-lg-8">
        <div class="fr-modal__body">
          <div class="fr-modal__header">
            <button class="fr-btn--close fr-btn"
                    title="<%= close_label %>"
                    aria-controls="<%= id %>">
              <%= close_label %>
            </button>
          </div>
          <div class="fr-modal__content">
            <h1 id="<%= id %>-title"
                class="fr-modal__title">
              <%= title %>
            </h1>
            <%= yield if block_given? %>
          </div>
          <div class="fr-modal__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline">
              <li>
                <button class="fr-btn fr-btn--secondary"
                        aria-controls="<%= id %>">
                  <%= cancel_label %>
                </button>
              </li>
              <li>
                <%= button_to confirm_label,
                      confirm_path,
                      method: local_assigns.fetch(:confirm_method, :post),
                      params: local_assigns.fetch(:confirm_params, {}),
                      form: local_assigns.fetch(:confirm_form, {}),
                      class: "fr-btn" %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>
