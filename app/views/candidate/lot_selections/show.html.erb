<% content_for :title, t('candidate.lot_selection.title') %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% public_market = @market_application.public_market %>
<% market_type_code = public_market.market_type_codes.first %>

<% if @editing %>
  <div class="fr-container fr-py-6w"
       data-controller="lot-selection"
       data-lot-selection-limit-value="<%= public_market.lot_limit.to_i %>"
       data-lot-selection-storage-key-value="lot-selection-<%= @market_application.identifier %>">
    <h1 class="fr-h3 fr-mb-1w"><%= t('candidate.lot_selection.title') %></h1>
    <p class="fr-text--sm fr-text--mention-grey fr-mb-3w">
      <%= t('candidate.lot_selection.subtitle') %>
    </p>

    <div class="fr-grid-row fr-grid-row--gutters">

      <%# Sidebar gauche %>
      <div class="fr-col-12 fr-col-md-5">
        <%= render 'market_info_card', public_market: public_market, presenter: @presenter %>

        <div class="fr-background-alt--grey" style="border: 1px solid var(--border-default-grey); padding: 20px 16px;">
          <h2 class="fr-text--bold fr-mb-0" style="font-size: 1rem;">
            <%= t('candidate.lot_selection.selected_lots_title') %>
          </h2>
          <hr class="fr-my-1w" style="border: none; border-top: 1px solid var(--border-default-grey);">
          <p class="fr-text--sm fr-text--mention-grey fr-mb-0" data-lot-selection-target="noLotsText">
            <%= t('candidate.lot_selection.no_lot_selected') %>
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" data-lot-selection-target="selectedLotsTags"></div>
        </div>
      </div>

      <%# Colonne droite : formulaire de sélection %>
      <div class="fr-col-12 fr-col-md-7">
        <% if @errors&.any? %>
          <div class="fr-alert fr-alert--error fr-mb-3w" role="alert">
            <ul class="fr-list">
              <% @errors.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with url: lot_selection_candidate_market_application_path(@market_application.identifier),
                      method: :patch,
                      local: true,
                      id: "lot-selection-form",
                      data: { turbo: false } do %>
          <% lots = public_market.lots.sort_by(&:position) %>

          <div class="fr-mb-4w" style="border: 1px solid var(--border-default-grey);">
            <div class="fr-px-3w fr-py-2w"
                 style="border-bottom: 1px solid var(--border-default-grey); display: flex; justify-content: space-between; align-items: center; background: var(--background-alt-grey);">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <%= market_type_icon_tag(public_market.market_type_codes) %>
                <div>
                  <p class="fr-text--bold fr-mb-0">
                    <%= market_type_code.present? ?
                          t("market_types.#{market_type_code}", default: market_type_code.humanize) :
                          t('candidate.lot_selection.lots_count', count: lots.size) %>
                  </p>
                  <p class="fr-text--sm fr-text--mention-grey fr-mb-0">
                    <%= t('candidate.lot_selection.available_lots_count', count: lots.size) %>
                  </p>
                </div>
              </div>
              <button type="button"
                      class="fr-link fr-text--xs"
                      style="text-decoration: underline;"
                      data-action="lot-selection#selectAll"
                      data-lot-selection-target="selectAllButton"
                      data-select-text="<%= t('candidate.lot_selection.select_all') %>"
                      data-deselect-text="<%= t('candidate.lot_selection.deselect_all') %>">
                <%= t('candidate.lot_selection.select_all') %>
              </button>
            </div>

            <% if public_market.lot_limit.present? %>
              <div class="fr-px-3w fr-pt-2w">
                <p class="fr-text--sm fr-mb-0" style="color: var(--text-default-error);">
                  <%= t('candidate.lot_selection.lot_limit_notice', count: public_market.lot_limit) %>
                </p>
                <p class="fr-text--sm fr-mb-0"
                   style="color: var(--text-default-error);"
                   data-lot-selection-target="limitError"
                   hidden>
                  <%= t('candidate.lot_selection.lot_limit_exceeded_notice', count: public_market.lot_limit) %>
                </p>
              </div>
            <% end %>

            <div class="fr-px-3w fr-py-2w" style="display: flex; flex-direction: column; gap: 1rem;">
              <% lots.each_with_index do |lot, index| %>
                <div class="fr-checkbox-group" style="display: flex; align-items: center;" data-lot-selection-target="checkboxGroup">
                  <%= check_box_tag "market_application[lot_ids][]",
                        lot.id,
                        @market_application.lot_ids.include?(lot.id),
                        id: "lot_#{lot.id}",
                        class: "fr-checkbox",
                        data: {
                          lot_selection_target: "checkbox",
                          action: "change->lot-selection#toggle",
                          lot_name: lot.name,
                          lot_type: @presenter.lot_type_label(lot)
                        } %>
                  <label class="fr-label" for="lot_<%= lot.id %>">
                    <%= lot.name %>
                    <span class="fr-hint-text">
                      <%= t('candidate.lot_selection.lot_number', number: index + 1) %>
                    </span>
                  </label>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <button type="submit"
                form="lot-selection-form"
                class="fr-btn fr-icon-arrow-right-line fr-btn--icon-right"
                style="width: 100%; justify-content: center;"
                data-lot-selection-target="submitButton"
                disabled>
          <%= t('candidate.lot_selection.next') %>
        </button>
      </div>

    </div>
  </div>

<% else %>
  <div class="fr-container fr-py-6w">
    <h1 class="fr-h3 fr-mb-1w"><%= t('candidate.lot_selection.prepare_title') %></h1>
    <p class="fr-text--sm fr-text--mention-grey fr-mb-3w">
      <%= t('candidate.lot_selection.prepare_subtitle') %>
    </p>

    <div class="fr-notice fr-notice--info fr-mb-4w">
      <div class="fr-notice__body">
        <p class="fr-notice__title"></p>
        <p class="fr-notice__desc">
          <%= t('candidate.lot_selection.single_form_notice') %>
        </p>
      </div>
    </div>

    <div class="fr-grid-row fr-grid-row--gutters">

      <%# Sidebar gauche %>
      <div class="fr-col-12 fr-col-md-5">
        <%= render 'market_info_card', public_market: public_market, presenter: @presenter %>

        <div class="fr-mb-2w fr-background-alt--grey" style="border: 1px solid var(--border-default-grey); padding: 20px 16px;">
          <div class="fr-mb-1w" style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="fr-text--bold fr-mb-0" style="font-size: 1rem;">
              <%= t('candidate.lot_selection.lots_list_title') %>
            </h2>
            <%= link_to lot_selection_candidate_market_application_path(@market_application.identifier, edit: 1),
                  class: "fr-btn fr-btn--tertiary-no-outline fr-btn--sm fr-icon-edit-fill",
                  title: t('candidate.lot_selection.edit_lots'),
                  aria: { label: t('candidate.lot_selection.edit_lots') } do %>
            <% end %>
          </div>
          <hr class="fr-my-1w" style="border: none; border-top: 1px solid var(--border-default-grey);">
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <% @presenter.selected_lots.each do |lot| %>
              <% type = @presenter.lot_type_label(lot) %>
              <span class="fr-tag" style="background: white;"><%= type ? "#{lot.name} - #{type}" : lot.name %></span>
            <% end %>
          </div>
        </div>

        <div class="fr-background-alt--grey" style="border: 1px solid var(--border-default-grey); padding: 20px 16px;">
          <h2 class="fr-text--bold fr-mb-0" style="font-size: 1rem;">
            <%= t('candidate.lot_selection.how_it_works_title') %>
          </h2>
          <hr class="fr-my-1w" style="border: none; border-top: 1px solid var(--border-default-grey);">
          <ol class="fr-text--sm" style="margin: 0; padding-left: 1.25rem;">
            <li><%= t('candidate.lot_selection.how_it_works_step_1') %></li>
            <li class="fr-mt-1w"><%= t('candidate.lot_selection.how_it_works_step_2') %></li>
          </ol>
        </div>
      </div>

      <%# Colonne droite : dossier de candidature %>
      <div class="fr-col-12 fr-col-md-7">
        <div class="fr-mb-3w" style="border: 1px solid var(--border-default-grey);">
          <div class="fr-px-3w fr-pt-2w" style="display: flex; align-items: center; gap: 0.5rem;">
            <%= market_type_icon_tag(public_market.market_type_codes) %>
            <% if market_type_code.present? %>
              <span class="fr-tag fr-tag--sm">
                <%= t("market_types.#{market_type_code}", default: market_type_code.humanize) %>
              </span>
            <% end %>
            <span class="fr-tag fr-tag--sm">
              <%= t('candidate.lot_selection.lots_count', count: @presenter.selected_lots.size) %>
            </span>
          </div>

          <div class="fr-px-3w fr-py-2w">
            <h2 class="fr-h6 fr-mb-1w"><%= t('candidate.lot_selection.application_form_title') %></h2>
            <p class="fr-text--sm fr-mb-2w"
               style="color: <%= @presenter.fields_complete? ? 'var(--text-default-success)' : 'var(--blue-france-sun-113-625)' %>;">
              <%= t('candidate.lot_selection.fields_count',
                    filled: @presenter.filled_fields_count,
                    total: @presenter.total_fields_count) %>
            </p>
            <div class="fr-text--right">
              <%= link_to step_candidate_market_application_path(@market_application.identifier, :api_data_recovery_status),
                    class: "fr-btn fr-icon-arrow-right-line fr-btn--icon-right" do %>
                <%= t(@presenter.cta_translation_key) %>
              <% end %>
            </div>
          </div>
        </div>

        <%= form_with url: lot_selection_candidate_market_application_path(@market_application.identifier),
                      method: :patch,
                      local: true,
                      data: { turbo: false } do %>
          <button type="submit"
                  name="final_submit"
                  value="1"
                  class="fr-btn fr-icon-send-plane-fill fr-btn--icon-right"
                  style="width: 100%; justify-content: center;"
                  <%= 'disabled' unless @presenter.form_started? %>>
            <%= t('candidate.lot_selection.submit') %>
          </button>
        <% end %>
      </div>

    </div>
  </div>
<% end %>
