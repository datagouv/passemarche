<% content_for :title, "#{@market_application.siret} - #{t('candidate.market_applications.steps.summary')}" %>

<%= render "stepper", step: step, wizard_steps: @wizard_steps %>

<% if @presenter&.optional_market_attributes? %>
  <%= render 'shared/notice',
             notice_text: t('candidate.market_applications.summary.buyer_additional_info_banner'),
             color: 'error' %>
<% end %>

<div class="fr-grid-row fr-grid-row--center"
     data-controller="summary-scan-refresh"
     data-summary-scan-refresh-url-value="<%= wizard_path %>.json">
  <div class="fr-col-12">
    <% if @presenter.lots_saved? %>
      <div class="fr-mb-4w">
        <%= render 'shared/application_lots_summary', presenter: @presenter %>
      </div>
    <% end %>
    <% if @presenter %>
      <div class="fr-mb-4w">
        <%= render 'shared/application_summary_content',
                   market_application: @market_application,
                   presenter: @presenter,
                   context: :web %>
      </div>
    <% end %>
  </div>
</div>

<div class="wizard-nav">
  <div class="fr-col-12">
    <div class="fr-mb-4w">
      <p class="fr-text--sm fr-text--mention-grey fr-text--bold" style="font-style: italic;">
        <%= t('candidate.market_applications.summary.submission_disclaimer') %>
      </p>
      <%= form_with model: @market_application, url: wizard_path, method: :put, local: true, data: { turbo: false } do |form| %>
        <div class="fr-btns-group fr-btns-group--right fr-btns-group--inline">
          <%= link_to previous_wizard_path, class: "fr-btn fr-btn--secondary" do %>
            <span class="fr-icon-arrow-left-line" aria-hidden="true"></span>
            <span class="fr-ml-1w"><%= t('candidate.shared.previous') %></span>
          <% end %>
          <% if @presenter.part_of_grouping? %>
            <%= render 'save_draft_button' %>
          <% end %>
          <% if @presenter.co_traitant_of_grouping? %>
            <button type="submit" class="fr-btn">
              <span><%= t('button.submit_to_mandataire') %></span>
              <span class="fr-icon-send-plane-fill fr-ml-1w" aria-hidden="true"></span>
            </button>
          <% else %>
            <button type="submit" class="fr-btn fr-btn--icon-right">
              <%= t('button.submit_summary') %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
