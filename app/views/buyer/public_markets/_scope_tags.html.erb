<% scopes.each do |scope| %>
  <% if scope == :commun %>
    <span class="fr-tag fr-tag--sm">
      <span class="fr-icon-links-fill fr-icon--xs" aria-hidden="true"></span>
      <%= t('buyer.public_markets.form_config.scope_commun_badge') %>
    </span>
  <% else %>
    <%= market_type_scope_tag(scope) %>
  <% end %>
<% end %>
