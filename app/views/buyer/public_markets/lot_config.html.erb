<% content_for :title, "#{@public_market.editor.name} - #{t('buyer.public_markets.lot_config.title')}" %>

<h1 class="fr-h1 fr-mb-1w"><%= t('buyer.public_markets.lot_config.title') %></h1>
<p class="fr-text--lg fr-mb-2w"><%= t('buyer.public_markets.lot_config.subtitle') %></p>
<% if (banner_text = @presenter.platform_type_banner_text) %>
  <%= render 'shared/notice', notice_text: banner_text %>
<% end %>

<div class="fr-grid-row fr-grid-row--gutters">
  <div class="fr-col-12 fr-col-md-4">
    <div class="fr-mb-3w fr-background-alt--grey" style="padding: 20px;">
      <h2 class="fr-text--md fr-text--bold" style="margin-bottom: 0.5rem;">
        <%= t('buyer.shared.market_info_title') %>
      </h2>
      <hr style="border: none; border-top: 1px solid var(--border-default-grey); margin: 0;">
      <%= render 'shared/sidebar_market_info',
            buyer_label: t('buyer.public_markets.lot_config.sidebar_buyer_label'),
            market_name: @public_market.buyer_display_name,
            typology_label: t('buyer.public_markets.lot_config.sidebar_typology_label'),
            market_types_label: @public_market.market_type_codes.any? ? @presenter.market_types_label : nil,
            deadline_label: t('buyer.shared.deadline_short'),
            deadline: l(@public_market.deadline, format: '%d/%m/%Y %H:%M') %>
    </div>

    <div class="fr-background-alt--grey" style="padding: 20px;">
      <h2 class="fr-text--md fr-text--bold" style="margin-bottom: 0.5rem;">
        <%= t('buyer.public_markets.lot_config.how_it_works_title') %>
      </h2>
      <hr style="border: none; border-top: 1px solid var(--border-default-grey); margin: 0;">
      <ol style="margin: 0; padding-left: 1.5rem; font-size: 0.875rem; display: flex; flex-direction: column; gap: 4px;">
        <li><%= t('buyer.public_markets.lot_config.how_it_works_step_1') %></li>
        <li><%= t('buyer.public_markets.lot_config.how_it_works_step_2') %></li>
        <li><%= t('buyer.public_markets.lot_config.how_it_works_step_3') %></li>
        <li><%= t('buyer.public_markets.lot_config.how_it_works_step_4') %></li>
      </ol>
    </div>
  </div>

  <div class="fr-col-12 fr-col-md-8">
    <% lot_limit_errors = @public_market.errors[:lot_limit] %>
    <%= form_with url: wizard_path, method: :put, local: true, data: { turbo: false } do |form| %>
      <div class="fr-mb-5w"
           data-controller="lot-type-picker"
           data-lot-type-picker-update-url-value="<%= buyer_lot_types_path(@public_market.identifier) %>">
        <h2 class="fr-h5 fr-mb-1w"><%= t('buyer.public_markets.lot_config.lots_section_title') %></h2>
        <p class="fr-text--sm fr-text--mention fr-mb-2w">
          <%= t('buyer.public_markets.lot_config.lots_section_subtitle') %>
        </p>
        <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--border-default-grey);">
          <thead>
            <tr style="background: var(--background-alt-grey);">
              <th scope="col" style="width: 3rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-default-grey); border-right: 1px solid var(--border-default-grey);"></th>
              <th scope="col" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-default-grey); text-align: left; font-weight: bold;">
                <%= t('buyer.public_markets.lot_config.column_lot') %>
              </th>
              <th scope="col" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-default-grey); text-align: left; font-weight: bold;">
                <%= t('buyer.shared.market_type_short') %>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @presenter.lots_for_config.each do |lot| %>
              <%= render 'buyer/public_markets/lot_row', lot: lot %>
            <% end %>
          </tbody>
        </table>

        <div data-lot-type-picker-target="panel"
             style="display: none; border: 1px solid var(--border-default-grey); padding: 2.5rem; margin-top: 1rem; background-color: #F5F5FE;">
          <p class="fr-text--md fr-text--bold fr-mb-2w">
            <%= t('buyer.public_markets.lot_config.type_picker_title') %>
          </p>
          <% picker_market_types = @presenter.picker_market_types %>
          <div style="display: flex; gap: 1rem; align-items: stretch; flex-wrap: wrap; margin-bottom: 1.5rem;">
            <% [['works', 'icon-travaux-only.svg'], ['services', 'icon-services-only.svg'], ['supplies', 'icon-fournitures-only.svg']].each do |code, icon| %>
              <% market_type = picker_market_types[code] %>
              <% next unless market_type %>
              <% bg = ApplicationHelper::MARKET_TYPE_CONFIGS.dig(code, :bg) %>
              <div style="display: flex; align-items: stretch; border: 1px solid var(--border-default-grey); overflow: hidden; flex: 1; min-width: 160px;">
                <label style="display: flex; align-items: center; gap: 0.75rem; padding: 12px 16px; cursor: pointer; background-color: #ffffff; flex: 1;">
                  <%= radio_button_tag :market_type_id, market_type.id, false,
                        id: "market_type_#{code}",
                        style: 'width: 1.125rem; height: 1.125rem; cursor: pointer; accent-color: var(--blue-france-sun-113-625); flex-shrink: 0;',
                        data: { 'lot-type-picker-target': 'radio' } %>
                  <span style="white-space: nowrap;"><%= t("market_types.#{code}") %></span>
                </label>
                <span style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background-color: <%= bg %>; flex-shrink: 0; padding: 16px;">
                  <%= image_tag icon, alt: '', aria: { hidden: true }, width: 24, height: 24 %>
                </span>
              </div>
            <% end %>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 1rem;">
            <%= button_tag t('buyer.public_markets.lot_config.type_picker_cancel'),
                  type: 'button',
                  class: 'fr-btn fr-btn--secondary',
                  style: 'background-color: #ffffff;',
                  data: { action: 'lot-type-picker#cancel' } %>
            <%= button_tag t('buyer.public_markets.lot_config.type_picker_apply'),
                  type: 'button',
                  class: 'fr-btn fr-icon-check-line fr-btn--icon-right',
                  data: { action: 'lot-type-picker#apply' } %>
          </div>
        </div>
      </div>

      <div class="fr-mb-5w" data-controller="radio-toggle">
        <h2 class="fr-h5 fr-mb-1w"><%= t('buyer.public_markets.lot_config.lot_limit_section_title') %></h2>
        <p class="fr-text--sm fr-text--mention fr-mb-3w">
          <%= t('buyer.public_markets.lot_config.lot_limit_section_subtitle') %>
        </p>
        <fieldset class="fr-fieldset fr-fieldset--inline fr-mb-3w" aria-labelledby="lot-limit-legend">
          <legend class="fr-fieldset__legend" id="lot-limit-legend">
            <%= t('buyer.public_markets.lot_config.lot_limit_question') %>
          </legend>
          <div class="fr-fieldset__content">
            <div class="fr-radio-group">
              <%= radio_button_tag :lot_limit_enabled, 'true',
                    @public_market.lot_limit.present?,
                    id: 'lot_limit_enabled_yes',
                    class: 'fr-radio',
                    data: { action: 'change->radio-toggle#toggle' } %>
              <%= label_tag 'lot_limit_enabled_yes',
                    t('buyer.public_markets.lot_config.lot_limit_yes'),
                    class: 'fr-label' %>
            </div>
            <div class="fr-radio-group">
              <%= radio_button_tag :lot_limit_enabled, 'false',
                    @public_market.lot_limit.nil?,
                    id: 'lot_limit_enabled_no',
                    class: 'fr-radio',
                    data: { action: 'change->radio-toggle#toggle' } %>
              <%= label_tag 'lot_limit_enabled_no',
                    t('buyer.public_markets.lot_config.lot_limit_no'),
                    class: 'fr-label' %>
            </div>
          </div>
        </fieldset>
        <div data-radio-toggle-target="field">
          <div class="fr-input-group <%= 'fr-input-group--error' if lot_limit_errors.any? %>">
            <%= label_tag :lot_limit,
                  t('buyer.public_markets.lot_config.lot_limit_label'),
                  class: 'fr-label' %>
            <%= number_field_tag :lot_limit,
                  @public_market.lot_limit,
                  class: "fr-input #{'fr-input--error' if lot_limit_errors.any?}",
                  min: 1,
                  max: @public_market.lots.size,
                  style: 'width: 250px;',
                  aria: (lot_limit_errors.any? ? { describedby: 'lot-limit-error' } : {}) %>
            <% if lot_limit_errors.any? %>
              <p id="lot-limit-error" class="fr-error-text"><%= lot_limit_errors.first %></p>
            <% end %>
          </div>
        </div>
      </div>
      <button type="submit" class="fr-btn fr-icon-arrow-right-line fr-btn--icon-right" style="width: 100%; justify-content: center;">
        <%= t('buyer.public_markets.lot_config.submit') %>
      </button>
    <% end %>
  </div>
</div>
