<tr id="lot_row_<%= lot.id %>" style="border-bottom: 1px solid var(--border-default-grey);">
  <td style="width: 3rem; padding: 0.75rem 1rem; text-align: center; vertical-align: middle; background: var(--background-alt-grey); border-right: 1px solid var(--border-default-grey);">
    <%= label_tag "lot_#{lot.id}", class: 'fr-sr-only' do %>
      <%= t('buyer.public_markets.lot_config.select_lot', name: lot.name) %>
    <% end %>
    <%= check_box_tag 'selected_lot_ids[]', lot.id, false,
          id: "lot_#{lot.id}",
          data: { action: 'change->lot-type-picker#toggle', 'lot-type-picker-target': 'checkbox' },
          style: 'width: 1.125rem; height: 1.125rem; cursor: pointer; accent-color: var(--blue-france-sun-113-625);' %>
  </td>
  <td style="padding: 0.75rem 1rem; vertical-align: middle;"><%= lot.name %></td>
  <td style="padding: 0.75rem 1rem; vertical-align: middle;"><%= render 'buyer/public_markets/lot_type_badge', lot: lot %></td>
</tr>
