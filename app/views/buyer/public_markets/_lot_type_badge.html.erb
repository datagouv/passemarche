<% effective = lot.effective_market_type %>
<% overridden = lot.market_type.present? && lot.platform_market_type.present? && lot.market_type != lot.platform_market_type %>
<% if overridden %>
  <span class="fr-badge fr-badge--sm fr-badge--no-icon fr-badge--warning" style="text-decoration: line-through;">
    <%= "#{t("market_types.#{lot.platform_market_type.code}")} (#{t('buyer.public_markets.lot_config.platform_source')})".upcase %>
  </span>
  <span class="fr-badge fr-badge--sm fr-badge--no-icon fr-badge--blue-cumulus">
    <%= t("market_types.#{lot.market_type.code}").upcase %>
  </span>
<% elsif effective.present? %>
  <span class="fr-badge fr-badge--sm fr-badge--no-icon">
    <%= "#{t("market_types.#{effective.code}")} (#{t('buyer.public_markets.lot_config.platform_source')})".upcase %>
  </span>
<% end %>
