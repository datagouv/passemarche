<% content_for :title, t('buyer.published.title') %>

<div class="fr-grid-row fr-grid-row--gutters status-page">
  <div class="fr-col-12 fr-col-lg-7 center-content">
    <div class="fr-mb-4w">
      <h1 class="fr-h3"><%= t('buyer.published.heading') %></h1>
      <p><%= t('buyer.published.explanation') %></p>
      <p><%= t('buyer.published.contact_hint') %></p>

      <% if (buyer_url = @public_market.editor.build_buyer_return_url(market: @public_market)) %>
        <div class="fr-btns-group fr-mt-3w">
          <%= link_to t('buyer.published.return_to_platform'),
                      buyer_url,
                      class: 'fr-btn' %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="fr-col-12 fr-col-lg-1"></div>

  <div class="fr-col-12 fr-col-lg-4 center-content">
    <%= image_tag "sync_status_error.png", alt: t('buyer.published.image_alt') %>
  </div>
</div>
